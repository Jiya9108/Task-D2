rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Posts and user plans are accessed only through the trusted Express backend.
    // Firebase Admin SDK requests from the backend bypass these client security rules.
    match /posts/{postId} {
      allow read, write: if false;
    }
    match /users/{userId} {
      allow read, write: if false;
    }
  }
}
